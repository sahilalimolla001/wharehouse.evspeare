# Copy this file to .env on the alwaysdata server and fill the real values.
# Do not commit the filled .env file.

APP_ENV=production
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-key

# alwaysdata PostgreSQL format:
# postgresql://USER:PASSWORD@postgresql-ACCOUNT.alwaysdata.net:5432/DATABASE
DATABASE_URL=postgresql://replace-user:replace-password@postgresql-replace-account.alwaysdata.net:5432/replace-database

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None
TRUST_PROXY_HEADERS=true
API_ALLOWED_ORIGINS=https://replace-account.alwaysdata.net
ALLOW_INSECURE_USER_HEADER=false

INTEGRATION_API_KEY=replace-with-a-long-random-api-key
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Owner Admin

MAX_UPLOAD_MB=8
GOOGLE_CLOUD_STORAGE_PUBLIC=false
GOOGLE_SHEETS_AUTO_SYNC=false

# Optional Google integration values. Leave empty until configured.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=CurrentStock!A:H
GOOGLE_SHEETS_SYNC_MODE=full
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_TOKEN=

# Razorpay payment refund processing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT=20
